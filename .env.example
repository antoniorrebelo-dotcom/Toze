# Copie para ".env" para testar localmente. No Netlify, estes valores vão em
# Site configuration > Environment variables (NUNCA no repositório).
#   npm run hash-password -- "palavra-passe"   -> hash
#   npm run new-secret                          -> SESSION_SECRET
COCOLOTO_USERS=viscondes:$2a$12$substitua.pelo.hash.gerado
SESSION_SECRET=substitua-por-um-texto-aleatorio-com-pelo-menos-32-caracteres
